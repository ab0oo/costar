{
  "version": 1,
  "shared_settings": {
    "solar_proxy_base": "http://vps.gorkos.net/solar",
    "image_proxy_base": "http://vps.gorkos.net/image"
  },
  "screen": {
    "id": "solar-fullscreen",
    "orientation": "landscape",
    "width": 320,
    "height": 220,
    "regions": [
      {
        "id": "solar-conditions",
        "widget": "solar-conditions",
        "x": 0,
        "y": 20,
        "w": 320,
        "h": 220,
        "draw_border": false
      }
    ]
  },
  "widget_defs": {
    "solar-conditions": {
      "type": "dsl",
      "update_ms": 1000,
      "settings": {
        "dsl_path": "/dsl_available/solar_conditions.json",
        "solar_proxy_base": "{{setting.solar_proxy_base}}"
      }
    }
  }
}
