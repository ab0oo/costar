[Unit]
Description=CoStar solar weather proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/costar-proxy/solar_proxy.py --port 8086
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solar-proxy

[Install]
WantedBy=multi-user.target
